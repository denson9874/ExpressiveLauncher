Google Play Store release manifest policy for Expressive Launcher L3.

Complies strictly with Google Play Store developer program policies:
- Excludes MANAGE_EXTERNAL_STORAGE (uses Storage Access Framework for user-selected folders).
- Excludes REQUEST_INSTALL_PACKAGES (updates delivered exclusively via Google Play Store).
- Retains standard Home role, AppWidget proxy, Smartspacer, and LauncherProvider capabilities.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ProtectedPermissions">

    <uses-sdk
        tools:overrideLibrary="com.kieronquinn.app.smartspacer.sdk.client" />

    <queries>
        <package android:name="dev.launcher.expressive.feed" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
    </queries>

    <!-- Both independently installed APKs declare this permission so either one can be installed
         first. Matching signatures are required before the launcher can bind the feed service. -->
    <permission
        android:name="dev.launcher.expressive.feed.permission.CONNECT"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.launcher.expressive.feed.permission.CONNECT" />

    <!-- Google Play builds receive updates exclusively through Google Play; remove install packages permission. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- LauncherProvider remains externally addressable, but only to same-signature clients. -->
    <permission
        android:name="${applicationId}.permission.READ_SETTINGS"
        android:description="@string/permdesc_read_settings"
        android:label="@string/permlab_read_settings"
        android:protectionLevel="signature"
        tools:node="replace" />
    <permission
        android:name="${applicationId}.permission.WRITE_SETTINGS"
        android:description="@string/permdesc_write_settings"
        android:label="@string/permlab_write_settings"
        android:protectionLevel="signature"
        tools:node="replace" />

    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS_FULL"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SUSPEND_APPS"
        tools:node="remove" />

    <!-- Protected platform capabilities that are unavailable to an ordinary Home-role APK. -->
    <uses-permission
        android:name="android.permission.MANAGE_USERS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FORCE_STOP_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_DEVICE_CONFIG"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_RESTRICTED_SETTINGS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ROTATE_SURFACE_FLINGER"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKEUP_SURFACE_FLINGER"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CAPTURE_BLACKOUT_CONTENT"
        tools:node="remove" />
    <!-- AppWidgetHost binding is authorized by the system confirmation flow. BIND_APPWIDGET is a
         signature-only permission that a Play-distributed Home app cannot receive. -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:node="remove" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Removed browser-history permissions no longer back any Launcher3 product behavior. -->
    <uses-permission
        android:name="android.permission.READ_HISTORY_BOOKMARKS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_HISTORY_BOOKMARKS"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- Google Play builds use a user-selected SAF folder for file search and strictly omit all-files access. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />

    <application
        android:name="app.lawnchair.LawnchairApp"
        android:backupAgent="com.android.launcher3.LauncherBackupAgent"
        android:fullBackupContent="@xml/backupscheme"
        android:fullBackupOnly="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher_home"
        android:label="@string/derived_app_name"
        android:largeHeap="@bool/config_largeHeap"
        android:restoreAnyVersion="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <receiver
            android:name="app.lawnchair.gestures.handlers.SleepMethodDeviceAdmin$SleepDeviceAdmin"
            android:description="@string/expressive_dt2s_admin_hint"
            tools:replace="android:description" />

        <activity
            android:name="app.lawnchair.LawnchairLauncher"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.SHOW_WORK_APPS" />
                <action android:name="android.intent.action.ALL_APPS" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="com.android.launcher3.grid.control"
                android:value="${applicationId}.grid_control" />
        </activity>

        <!--
             Keep the result proxy even though this flavor is not a privileged Quickstep
             implementation. QuickstepLauncher routes AppWidget bind/configuration activities
             through this internal activity so results survive Launcher task recreation. Removing
             it made every first-time widget bind crash with ActivityNotFoundException.
        -->
        <activity
            android:name="com.android.launcher3.proxy.ProxyActivityStarter"
            android:clearTaskOnLaunch="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/ProxyActivityStarterTheme"
            tools:node="merge" />
    </application>
</manifest>
