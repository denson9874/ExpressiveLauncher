{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 ci/*)",
      "Bash(python3 scripts/bump_version.py *)",
      "Bash(python3 scripts/format_xda.py *)",
      "Bash(python3 ~/.claude/skills/expressive-xda-feedback/scripts/route_qa.py *)",
      "Bash(adb *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh release view *)",
      "Bash(gh release list*)",
      "Read(~/Library/Application Support/Expressive CI/**)",
      "Edit(~/Library/Application Support/Expressive CI/feedback/xda/**)"
    ],
    "ask": [
      "Bash(python3 ci/jenkins/control.py run *)",
      "Bash(gh release edit *)",
      "Bash(python3 scripts/post_telegram.py *)",
      "Bash(python3 scripts/release_unified.py *)",
      "Bash(python3 scripts/publish_play_bundle.py *)"
    ],
    "deny": [
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/Library/Application Support/Expressive CI/config/**)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)"
    ],
    "additionalDirectories": [
      "~/Library/Application Support/Expressive CI/feedback/xda"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 10,
            "statusMessage": "Checking release guardrails"
          }
        ]
      }
    ]
  }
}
