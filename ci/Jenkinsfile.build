pipeline {
    agent { label 'expressive-macos-android' }
    options { disableConcurrentBuilds(); timeout(time: 90, unit: 'MINUTES'); skipDefaultCheckout() }
    parameters {
        string(name: 'SOURCE_REVISION', defaultValue: '', description: 'Full recorded commit on codex/pixel-parity')
        string(name: 'VERSION_NAME', defaultValue: '', description: 'Required: expected QA version from the recorded source')
        string(name: 'VERSION_CODE', defaultValue: '', description: 'Required: monotonically increasing version code from the recorded source')
        string(name: 'BASELINE_RELEASE_ID', defaultValue: '', description: 'Optional sealed QA baseline for initial GitHub channel bootstrap')
    }
    environment {
        SOURCE_REPOSITORY = '/Users/daryldenson/Developer/ExpressiveLauncher'
        EXPRESSIVE_CI_HOME = '/Users/daryldenson/Library/Application Support/Expressive CI'
        ANDROID_HOME = '/Users/daryldenson/Library/Android/sdk'
        ANDROID_SDK_ROOT = '/Users/daryldenson/Library/Android/sdk'
        JAVA_HOME = '/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home'
        EXPRESSIVE_KEYSTORE_PROPERTIES = '/Users/daryldenson/Developer/ExpressiveLauncher/keystore.properties'
        PATH = '/opt/homebrew/opt/openjdk@21/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin'
    }
    stages {
        stage('Prepare recorded source') {
            steps {
                script {
                    if (!(params.SOURCE_REVISION ==~ /[0-9a-f]{40}/)) { error('A full source commit is required') }
                    if (!(params.VERSION_NAME ==~ /[0-9]+\.[0-9]+\.[0-9]+/) || !(params.VERSION_CODE ==~ /[1-9][0-9]*/)) { error('Invalid version') }
                    if (params.BASELINE_RELEASE_ID && !(params.BASELINE_RELEASE_ID ==~ /qa-[0-9]+\.[0-9]+\.[0-9]+-[0-9]+-build-[0-9]+/)) { error('Invalid baseline release ID') }
                    env.RUN_WORKSPACE = "${env.WORKSPACE}/build-${env.BUILD_NUMBER}"
                    env.RELEASE_ID = "qa-${params.VERSION_NAME}-${params.VERSION_CODE}-build-${env.BUILD_NUMBER}"
                    env.CORE_RELEASE_ID = "qa-core-${params.VERSION_NAME}-${params.VERSION_CODE}-build-${env.BUILD_NUMBER}"
                }
                sh '''git -C "$SOURCE_REPOSITORY" show "$SOURCE_REVISION:ci/prepare_build.py" > "$WORKSPACE/prepare-$BUILD_NUMBER.py"
                python3 "$WORKSPACE/prepare-$BUILD_NUMBER.py" --repository "$SOURCE_REPOSITORY" --revision "$SOURCE_REVISION" --workspace "$RUN_WORKSPACE" --baseline-release-id "$BASELINE_RELEASE_ID"'''
            }
        }
        stage('Pipeline contract tests') {
            steps { sh '''cd "$RUN_WORKSPACE/source"
                python3 -m unittest discover -s ci/tests -v
            ''' }
        }
        stage('Unit tests and signed QA build') {
            steps { sh '''cd "$RUN_WORKSPACE/source"
                ./gradlew --no-scan --console=plain -PexpressiveTestBuildType=qa testLawnWithQuickstepExpressiveQaUnitTest assembleLawnWithQuickstepExpressiveQa
                # Release the Gradle and Kotlin daemons' memory before the emulator boots.
                ./gradlew --stop
            ''' }
        }
        stage('Verify package and signing continuity') {
            steps { sh '''cd "$RUN_WORKSPACE/source"
                python3 ci/pipeline.py stage --workspace "$RUN_WORKSPACE" --version-name "$VERSION_NAME" --version-code "$VERSION_CODE"
            ''' }
        }
        stage('Isolated Android upgrade and smoke QA') {
            steps { sh '''cd "$RUN_WORKSPACE/source"
                python3 ci/pipeline.py smoke --workspace "$RUN_WORKSPACE" --source-revision "$SOURCE_REVISION"
            ''' }
        }
        stage('Retain tested release candidate') {
            steps { sh '''cd "$RUN_WORKSPACE/source"
                python3 ci/finalize_qa.py --artifact-dir "$RUN_WORKSPACE/artifacts" --source-dir "$RUN_WORKSPACE/source" --release-dir "$EXPRESSIVE_CI_HOME/releases/$RELEASE_ID" --build-url "$BUILD_URL"
            ''' }
        }
        // Expressive Core (XDA-021) runs after the Full candidate is sealed. A Core failure marks only
        // this stage failed: the Full seal stays publishable and release_unified.py skips Core.
        stage('Expressive Core build, smoke QA and seal') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh '''cd "$RUN_WORKSPACE/source"
                        if ! ./gradlew --no-scan --console=plain -PexpressiveCore=true assembleLawnWithQuickstepExpressiveQa; then
                            ./gradlew --stop; exit 1
                        fi
                        ./gradlew --stop
                        python3 ci/pipeline.py stage --variant core --workspace "$RUN_WORKSPACE" --version-name "$VERSION_NAME" --version-code "$VERSION_CODE"
                        python3 ci/pipeline.py smoke --variant core --workspace "$RUN_WORKSPACE" --source-revision "$SOURCE_REVISION"
                        python3 ci/finalize_qa.py --artifact-dir "$RUN_WORKSPACE/artifacts-core" --source-dir "$RUN_WORKSPACE/source" --release-dir "$EXPRESSIVE_CI_HOME/releases/$CORE_RELEASE_ID" --build-url "$BUILD_URL"
                    '''
                }
            }
        }
    }
    post {
        always {
            junit testResults: "build-${env.BUILD_NUMBER}/source/build/test-results/test*UnitTest/TEST-*.xml", allowEmptyResults: true
            archiveArtifacts artifacts: "build-${env.BUILD_NUMBER}/artifacts/**,build-${env.BUILD_NUMBER}/artifacts-core/**", allowEmptyArchive: true, fingerprint: true
        }
    }
}
