<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="dev.launcher.expressive.feed.permission.CONNECT"
        android:label="@string/connect_permission_label"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
            <data android:scheme="app" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".ExpressiveFeedBridgeService"
            android:enabled="true"
            android:exported="true"
            android:permission="dev.launcher.expressive.feed.permission.CONNECT">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
                <data android:scheme="app" />
            </intent-filter>
        </service>
    </application>

</manifest>
